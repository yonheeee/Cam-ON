# 이 파일을 frontend/.env로 복사해서 실제 값을 채운다(.env는 커밋되지 않는다).
#
# 주의: VITE_ 접두사가 붙은 값은 빌드 시 클라이언트 번들에 그대로 박히므로 브라우저에서 누구나
# 볼 수 있다. 비밀은 절대 여기 두지 않는다 — LiveKit API key/secret은 토큰을 서명하는 백엔드
# (backend/.env)만 알아야 한다.

# LiveKit Cloud 프로젝트의 서버 URL (예: wss://your-project.livekit.cloud).
# 백엔드가 토큰을 서명할 때 쓰는 프로젝트(backend/.env의 LIVEKIT_URL)와 반드시 같아야 한다 —
# 어긋나면 토큰 서명은 정상인데 연결만 거부돼서 원인을 찾기 어렵다.
VITE_LIVEKIT_URL=replace-me

# 비워두면 roomApi/ninjaApi가 window.location.hostname:8080으로 자동 계산한다
# (localhost로 열든 LAN IP로 열든 같은 머신의 백엔드를 가리키게 하기 위함).
# 백엔드가 다른 머신에 있을 때만 지정한다.
# VITE_API_BASE_URL=http://localhost:8080
