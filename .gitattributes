Jenkinsfile text eol=lf
# `deploy/*.sh`는 deploy/ 바로 아래만 매칭한다(단일 *는 /를 넘지 않음). 하위 디렉터리까지
# 덮으려면 **가 필요하다 — 안 그러면 Windows에서 체크아웃한 스크립트가 CRLF로 바뀌고,
# 그걸 EC2로 올리면 셰뱅이 깨져서 "bad interpreter"로 죽는다.
deploy/**/*.sh text eol=lf
deploy/**/*.py text eol=lf
deploy/**/*.yml text eol=lf
deploy/Caddyfile text eol=lf
