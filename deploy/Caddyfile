{$DOMAIN} {
	encode gzip

	# REST API
	handle /api/* {
		reverse_proxy backend:8080
	}

	# STOMP(WebSocket) — Caddy는 Connection: Upgrade 헤더를 자동으로 인식해서
	# 별도 설정 없이 웹소켓을 그대로 프록시한다.
	handle /ws* {
		reverse_proxy backend:8080
	}

	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# Swagger/OpenAPI (springdoc)
	handle /swagger-ui/* {
		reverse_proxy backend:8080
	}
	handle /v3/api-docs/* {
		reverse_proxy backend:8080
	}

	# 나머지는 프론트 정적 파일 — React Router가 클라이언트 사이드 라우팅을 하므로
	# 존재하지 않는 경로는 전부 index.html로 fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
