# 도메인 & 인증서 (Caddy가 이 도메인으로 Let's Encrypt 인증서를 자동 발급/갱신한다)
DOMAIN=i15b110.p.ssafy.io

BACKEND_IMAGE=camon-backend:local
FRONTEND_IMAGE=camon-web:local
SPRING_PROFILES_ACTIVE=local

# MySQL
MYSQL_DATABASE=camon
MYSQL_USER=camon
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me

# LiveKit Cloud (backend/.env와 동일한 값을 쓰면 됨)
# LIVEKIT_URL은 백엔드 토큰 서명뿐 아니라 프론트 빌드(VITE_LIVEKIT_URL)에도 쓰인다 — 키를 새로
# 발급받으면 이 값만 바꾸고 재배포하면 양쪽이 함께 따라간다(프론트 코드는 안 건드림).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# AI 서버 (물건 가져오기 손에 든 물체 인식). Spring과 별개 호스트라 주소를 따로 준다 —
# 프론트 빌드의 VITE_AI_BASE_URL로 들어간다.
#
# 반드시 https여야 한다. 이 사이트는 HTTPS라 http 주소로 호출하면 브라우저가 mixed content로
# 차단하고, 그러면 배포 사이트에서 물건 가져오기 인식이 통째로 죽는다. 비워두면 compose가
# 빌드를 아예 거부한다(폴백 http://<접속호스트>:8100으로 조용히 깨지는 것보다 낫다).
#
# 지금은 GPU가 달린 개발용 노트북을 Tailscale Funnel로 공개해서 쓴다(공개 HTTPS + 정식 인증서).
# 브라우저가 EC2를 거치지 않고 이 주소로 직접 프레임을 보내므로 서버 대역폭을 안 먹는다.
# 주소가 바뀌면 이 값을 고치고 프론트를 재빌드해야 한다(Vite가 빌드 시점에 번들에 굽는다).
AI_BASE_URL=https://your-ai-host.example.ts.net
